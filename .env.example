# Copy this file to .env and fill in real values. Never commit .env itself.

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

SUPABASE_URL=
SUPABASE_KEY=

# Shared secret required by /api/scheduled/run. Generate any long random string,
# e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set the SAME value in Vercel's environment variables so Vercel Cron's
# Authorization: Bearer <CRON_SECRET> header (or your external cron caller's
# X-Cron-Secret header) is accepted.
CRON_SECRET=
